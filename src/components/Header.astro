---
const base = import.meta.env.BASE_URL;
---
<header class="border-b border-[var(--color-line)]">
  <nav class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-5 gap-y-2 px-4 py-4">
    <a href={base} class="text-lg font-semibold tracking-tight text-[var(--color-ink)]">
      Cursed Shrine
    </a>
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
      <a href={`${base}/search`} class="text-[var(--color-muted)] hover:text-[var(--color-accent)]">Search</a>
    </div>
  </nav>
</header>
