---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const { title, description, date, category, draft } = post.data;
---
<article class="border-b border-[var(--color-line)] py-6">
  <div class="mb-1 flex items-center gap-3 text-xs text-[var(--color-muted)]">
    <time datetime={date.toISOString()}>
      {date.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}
    </time>
    <span>{CATEGORIES[category]}</span>
    {draft && <span class="rounded bg-[var(--color-bg-sec)] px-1.5 py-0.5 text-[var(--color-ink)]">DRAFT</span>}
  </div>
  <h2 class="text-xl font-semibold">
    <a href={`${base}/posts/${post.id}`} class="hover:text-[var(--color-accent)]">{title}</a>
  </h2>
  <p class="mt-1 text-[var(--color-ink-dim)]">{description}</p>
</article>
