---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<footer class="mt-16 border-t border-[var(--color-line)]">
  <div class="mx-auto flex max-w-[52rem] flex-wrap justify-between gap-2 px-4 py-6 text-sm text-[var(--color-muted)]">
    <span>© {year} Cursed Shrine</span>
    <span class="flex gap-5">
      <a href="https://cursedshrine.com" class="hover:text-[var(--color-accent)]">Home</a>
      <a href="https://gaurav.cursedshrine.com" class="hover:text-[var(--color-accent)]">Portfolio</a>
      <a href={`${base}/rss.xml`} class="hover:text-[var(--color-accent)]">RSS</a>
    </span>
    <!-- Shared credit, same as cursedshrine.com and the games. -->
    <span class="basis-full text-right text-[0.8rem]">
      developed and managed by{' '}
      <a href="https://gaurav.cursedshrine.com" class="font-semibold text-[var(--color-accent)] hover:underline">Gaurav Rathore</a>
    </span>
    <span class="-mt-1.5 basis-full text-right text-[0.7rem] italic opacity-85">With the help of Claudy Rex (AI Assistant)</span>
  </div>
</footer>
