---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { prodUrl } from '../lib/site';
const posts = await getPosts();
const base = import.meta.env.BASE_URL;
const blogUrl = prodUrl(`${base}/`).href;

const blog = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Cursed Shrine',
  description: 'Tech, homelab teardowns, finance and books. Written from a Raspberry Pi.',
  url: blogUrl,
  inLanguage: 'en',
  author: { '@type': 'Person', name: 'Gaurav' },
  // The ten newest are enough as a discovery hint; the sitemap is the
  // complete list and the one Google actually crawls.
  blogPost: posts.slice(0, 10).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    datePublished: post.data.date.toISOString(),
    url: prodUrl(`${base}/posts/${post.id}/`).href,
  })),
};
---
<BaseLayout
  title="Cursed Shrine — Blog"
  description="Tech, homelab teardowns, finance and books. Written from a Raspberry Pi."
  jsonLd={[blog]}
>
  <h1 class="text-2xl font-bold tracking-tight">Latest</h1>
  {posts.length === 0 ? (
    <p class="mt-6 text-[var(--color-muted)]">No posts published yet.</p>
  ) : (
    posts.map((post) => <PostCard post={post} />)
  )}
</BaseLayout>
