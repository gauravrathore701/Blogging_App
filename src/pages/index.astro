---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { prodUrl } from '../lib/site';
const posts = await getPosts();
const base = import.meta.env.BASE_URL;
const blogUrl = prodUrl(`${base}/`).href;
// Oldest first so the series reads in order.
// shortcut: same-day posts keep collection (alphabetical) order, reversed; add a series number field if that ever lists them wrong.
const backend = posts.filter((p) => p.data.tags.includes('backend-concepts')).reverse();

const blog = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Cursed Shrine',
  description: 'Tech, homelab teardowns, finance and books. Written from a Raspberry Pi.',
  url: blogUrl,
  inLanguage: 'en',
  author: { '@type': 'Person', name: 'Gaurav' },
  // The ten newest are enough as a discovery hint; the sitemap is the
  // complete list and the one Google actually crawls.
  blogPost: posts.slice(0, 10).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    datePublished: post.data.date.toISOString(),
    url: prodUrl(`${base}/posts/${post.id}/`).href,
  })),
};
---
<BaseLayout
  title="Cursed Shrine — Blog"
  description="Tech, homelab teardowns, finance and books. Written from a Raspberry Pi."
  jsonLd={[blog]}
>
  <h1 class="text-2xl font-bold tracking-tight">Latest</h1>
  {posts.length === 0 ? (
    <p class="mt-6 text-[var(--color-muted)]">No posts published yet.</p>
  ) : (
    posts.map((post) => <PostCard post={post} />)
  )}
  {backend.length > 0 && (
    <aside class="series" aria-labelledby="series-title">
      <h2 id="series-title">Backend Concepts</h2>
      <ul>
        {backend.map((post) => (
          <li><a href={`${base}/posts/${post.id}/`}>{post.data.title.split(':')[0]}</a></li>
        ))}
      </ul>
    </aside>
  )}
</BaseLayout>

<style>
  /* Lives in the right paper margin, so it only shows when that margin
     is wide enough to hold it without touching the 52rem column. */
  .series {
    display: none;
    position: fixed;
    top: 6rem;
    /* stays right of the 81.5% fold crease (see body background in global.css) */
    left: calc(81.5% + 1rem);
    right: 0.75rem;
    max-height: calc(100dvh - 8rem);
    overflow-y: auto;
    padding: 1rem 1.25rem;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    box-shadow: 0 2px 10px rgba(80, 62, 35, 0.12);
  }
  @media (min-width: 1440px) {
    .series { display: block; }
  }
  .series h2 {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.6rem;
  }
  .series ul { list-style: disc; padding-left: 1.25rem; }
  .series li { margin: 0.35rem 0; font-size: 0.9rem; color: var(--color-muted); }
  .series a { color: var(--color-ink-dim); }
  .series a:hover { color: var(--color-accent); text-decoration: underline; }
</style>
