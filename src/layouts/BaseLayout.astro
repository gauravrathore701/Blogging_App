---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { prodUrl } from '../lib/site';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Set on the dev build so a stray crawler never indexes it. */
  noindex?: boolean;
  /** 'article' on a post, 'website' everywhere else. */
  ogType?: string;
  /** Card image, base-relative (e.g. '/og/slug.png'). Falls back to the site card. */
  image?: string;
  /** schema.org objects; rendered as one ld+json block per entry. */
  jsonLd?: Record<string, unknown>[];
}
const {
  title,
  description,
  noindex = false,
  ogType = 'website',
  image,
  jsonLd = [],
} = Astro.props;
// Drafts stay self-canonical: no production URL exists for them, and they are
// noindex anyway. Everything else points at production — see src/lib/site.ts.
const canonical = noindex
  ? new URL(Astro.url.pathname, Astro.site)
  : prodUrl(Astro.url.pathname);
// Shares need a raster card: X, WhatsApp and LinkedIn all ignore SVG, which is
// all public/ used to hold. public/og/*.png is generated by
// scripts/make-og-images.py (npm prebuild), one per post plus a default.
const ogImage = new URL(
  `${import.meta.env.BASE_URL}${image ?? '/og/default.png'}`.replace(/\/{2,}/g, '/'),
  Astro.site,
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon-mark.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/logo-icon.svg`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Cursed Shrine" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="Cursed Shrine"
          href={new URL(`${import.meta.env.BASE_URL}/rss.xml`, Astro.site)} />
    {/* Structured data is skipped on noindex (dev) pages — nothing should be
        eligible for a rich result from a build that is not meant to be seen. */}
    {!noindex && jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="relative flex min-h-dvh flex-col">
    <Header />
    <main class="relative mx-auto w-full max-w-[52rem] flex-1 px-4 py-8">
      <slot />
    </main>
    <Footer />
    <!-- Shared Cursed Shrine doodles (same storage as the homepage and games):
         5–7 per load, kept inside the outer margins between the page edge and the
         22% / 81% fold creases. Absolute URL so every environment gets it too. -->
    <script is:inline src="https://cursedshrine.com/doodles.js?v=20260913c" defer></script>
  </body>
</html>
