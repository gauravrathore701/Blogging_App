---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Set on the dev build so a stray crawler never indexes it. */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon-mark.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/logo-icon.svg`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="Cursed Shrine"
          href={new URL(`${import.meta.env.BASE_URL}/rss.xml`, Astro.site)} />
  </head>
  <body class="relative flex min-h-dvh flex-col">
    <Header />
    <main class="relative mx-auto w-full max-w-[52rem] flex-1 px-4 py-8">
      <slot />
    </main>
    <Footer />
    <!-- Shared Cursed Shrine doodles (same storage as the homepage and games):
         5–7 per load, kept inside the outer margins between the page edge and the
         22% / 81% fold creases. Absolute URL so dev.cursedshrine.com gets it too. -->
    <script is:inline src="https://cursedshrine.com/doodles.js?v=20260913c" defer></script>
  </body>
</html>
