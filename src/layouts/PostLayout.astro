---
import BaseLayout from './BaseLayout.astro';
import { CATEGORIES } from '../lib/posts';
import { PROD_SITE, prodUrl } from '../lib/site';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { title, description, date, updated, category, tags, draft } = post.data;
const base = import.meta.env.BASE_URL;

// Structured data describes the production page, matching the canonical the
// layout emits. og:image stays on the serving host so a dev share still shows
// its card.
const canonical = prodUrl(Astro.url.pathname);
const ogImage = prodUrl(`${base}/og/${post.id}.png`);

// BlogPosting + a breadcrumb. Written from the same frontmatter the page
// renders, so the markup and the structured data cannot drift apart.
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  image: ogImage.href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
  url: canonical.href,
  // Trailing slash matters: a bare origin leaves `...com"},"publisher":{"@`
  // in the minified JSON, which the deploy leak scanner reads as
  // credentials-in-URL (`host:pass@`) and blocks the deploy on. (2026-10-11)
  author: { '@type': 'Person', name: 'Gaurav', url: `${PROD_SITE}/` },
  publisher: { '@type': 'Organization', name: 'Cursed Shrine', url: `${PROD_SITE}/` },
  articleSection: CATEGORIES[category],
  inLanguage: 'en',
  ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: prodUrl(`${base}/`).href },
    { '@type': 'ListItem', position: 2, name: CATEGORIES[category], item: prodUrl(`${base}/category/${category}/`).href },
    { '@type': 'ListItem', position: 3, name: title, item: canonical.href },
  ],
};
---
<BaseLayout
  title={title}
  description={description}
  noindex={draft}
  ogType="article"
  image={`/og/${post.id}.png`}
  jsonLd={[blogPosting, breadcrumb]}
>
  <article data-pagefind-body>
    {draft && (
      <p class="mb-4 rounded border border-[var(--color-muted)] px-3 py-2 text-sm text-[var(--color-accent-dim)]">
        Draft — visible on the dev site only.
      </p>
    )}
    <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
    <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-[var(--color-muted)]">
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <a href={`${base}/category/${category}`} class="hover:text-[var(--color-accent)]">
        {CATEGORIES[category]}
      </a>
      {updated && <span>updated {updated.toLocaleDateString('en-IN')}</span>}
    </div>
    <div class="prose-blog mt-8">
      <slot />
    </div>
    {tags.length > 0 && (
      <ul class="mt-10 flex flex-wrap gap-2 text-xs text-[var(--color-muted)]">
        {tags.map((t) => <li class="rounded border border-[var(--color-line)] px-2 py-1">#{t}</li>)}
      </ul>
    )}
  </article>
</BaseLayout>
