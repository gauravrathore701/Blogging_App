@import 'tailwindcss';

/* Old-novel paper palette. Warm cream ground, matte ink.
   Deliberately NOT the charcoal palette the other sites share —
   this one is meant to read like a printed page. */
@theme {
  --color-bg: #e8dfc9;        /* aged paper, dimmed */
  --color-bg-sec: #ddd2b7;    /* deeper leaf, for surfaces */
  --color-ink: #2b2723;       /* headings — matte, warm, never #000 */
  --color-ink-dim: #3f3830;   /* body copy, a shade softer */
  --color-accent: #6b4a2f;    /* links, sepia ink */
  --color-accent-dim: #8a6a4b;
  --color-muted: #6f6555;     /* captions, quotes, meta */
  --color-line: #cbbd9e;      /* hairlines */
  --font-sans: ui-sans-serif, system-ui, sans-serif;
}

html {
  background-color: var(--color-bg);
  color: var(--color-ink);
  scroll-behavior: smooth;
}

body { min-height: 100dvh; }

.prose-blog :where(h2, h3) { color: var(--color-ink); font-weight: 600; }
.prose-blog h2 { font-size: 1.5rem; margin: 2rem 0 0.75rem; }
.prose-blog h3 { font-size: 1.2rem; margin: 1.5rem 0 0.5rem; }
.prose-blog p { margin: 0 0 1rem; line-height: 1.75; color: var(--color-ink-dim); }
.prose-blog a { color: var(--color-accent); text-decoration: underline; }
.prose-blog ul, .prose-blog ol { margin: 0 0 1rem 1.25rem; list-style: disc; }
.prose-blog li { margin: 0.25rem 0; color: var(--color-ink-dim); }
.prose-blog pre {
  padding: 1rem; border-radius: 0.5rem; overflow-x: auto; margin: 0 0 1rem;
  /* github-light ships a near-white bg; tint it toward the page so code
     blocks read as inset paper rather than a white hole. */
  background-color: var(--color-bg-sec) !important;
  border: 1px solid var(--color-line);
}
.prose-blog :not(pre) > code {
  background-color: var(--color-bg-sec);
  padding: 0.1em 0.35em; border-radius: 0.25rem;
}
.prose-blog code { font-size: 0.9em; }
.prose-blog blockquote {
  border-left: 3px solid var(--color-muted);
  padding-left: 1rem; margin: 0 0 1rem; color: var(--color-muted);
}
