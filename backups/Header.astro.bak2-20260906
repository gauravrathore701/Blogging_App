---
const base = import.meta.env.BASE_URL;
---
<header class="border-b border-[var(--color-line)]">
  <nav class="mx-auto flex max-w-3xl items-center gap-x-5 px-4 py-4">
    <a href={base} class="text-lg font-semibold tracking-tight text-[var(--color-ink)]">
      Cursed Shrine
    </a>
    <!-- ml-auto pins search to the far right instead of sitting next to
         the wordmark. Icon only; the label stays for screen readers. -->
    <a
      href={`${base}/search`}
      aria-label="Search"
      title="Search"
      class="ml-auto inline-flex h-9 w-9 items-center justify-center rounded-full text-[var(--color-muted)] transition-colors hover:bg-[var(--color-bg-sec)] hover:text-[var(--color-accent)]"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
           stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <line x1="16.5" y1="16.5" x2="21" y2="21" />
      </svg>
      <span class="sr-only">Search</span>
    </a>
  </nav>
</header>
